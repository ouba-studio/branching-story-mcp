    value: "10.5281/zenodo.24549412"
    description: Preprint — State Drift in Consumer LLM Interactive Fiction
  - type: doi
    value: "10.7910/DVN/YEBHQR"
    description: Primary benchmark dataset (CC-BY-4.0)
  - type: url
    value: "https://github.com/ouba-studio/branching-story-mcp"
  - type: url
    value: "https://pypi.org/project/branching-story-mcp/"
  - type: url
    value: "https://jsr.io/@ouba-studio/branching-story-mcp"
keywords:
  - model-context-protocol
  - mcp
  - interactive-fiction
  - branching-narrative
  - story-state
  - llm-evaluation
  - silent-state-drift
  - benchmark
